                </mxCell>
                <mxCell id="sprint5-snapshot" parent="1" vertex="1" value="bookings.package_name is captured when the booking is created.&lt;br&gt;NULL package_id / package_name = tour has no packages.&lt;br&gt;Nullable requested_schedule_id = new schedule for change_date.&lt;br&gt;handled_by references users(id), unlike the non-FK audit IDs on page 05." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
