                <mxCell id="economy-settings-note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" value="Standalone settings (no relationships).&lt;br&gt;commission_percent = 10; hold_minutes = 30;&lt;br&gt;booking_cutoff_minutes = 60; vietqr_cutoff_hours = 24;&lt;br&gt;payouts_from = payout eligibility starting timestamp." vertex="1">
