                </mxCell>
                <mxCell id="economy-snapshot" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" value="gross_vnd / kept_vnd = receipts after refunds.&lt;br&gt;commission_rate is captured when booking.&lt;br&gt;Payout bank details are captured when marked paid.&lt;br&gt;bank_verified_at IS NULL = bank account awaiting verification.&lt;br&gt;Provider login remains users (role provider) + providers." vertex="1">
