                <mxCell id="economy-constraints" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" value="All new FKs: ON DELETE RESTRICT / ON UPDATE CASCADE.&lt;br&gt;UNIQUE uq_host_payouts_schedule (schedule_id)&lt;br&gt;UNIQUE uq_host_payout_items_booking (booking_id)&lt;br&gt;Tour self-reference: UNIQUE uq_tours_revision_of; FK fk_tours_revision_of.&lt;br&gt;settings.updated_by, providers.bank_verified_by, host_payouts.paid_by have no FK." vertex="1">
