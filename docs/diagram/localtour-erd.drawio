                <mxCell id="sprint5-constraints" parent="1" vertex="1" value="UNIQUE uq_tour_packages_name (tour_id, name)&lt;br&gt;INDEX idx_tour_packages_tour (tour_id, active, sort_order)&lt;br&gt;INDEX idx_bookings_package (package_id)&lt;br&gt;FK fk_bookings_package: bookings.package_id -&gt; tour_packages.id&lt;br&gt;All six FKs: ON DELETE RESTRICT / ON UPDATE CASCADE." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;">
