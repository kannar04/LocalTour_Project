# Thư mục ảnh tải lên (ảnh tour, ảnh đại diện): chỉ phục vụ file ảnh, không liệt kê thư mục và không chạy mã.
Options -Indexes

<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|html?|svg)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
