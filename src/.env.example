# Sao chép file này thành .env (cùng thư mục src/) rồi điền thông tin thật.
# KHÔNG commit file .env lên Git.

APP_ENV=local
# true chỉ dùng khi debug trên máy cá nhân; demo/QA luôn để false.
APP_DEBUG=false
# Để trống để link tự tính theo thư mục đang chạy (khuyến nghị).
APP_URL=

# Database dùng chung do nhóm trưởng host: hỏi Phong địa chỉ và tài khoản.
# Chạy database trên máy mình thì giữ 127.0.0.1 / root / mật khẩu trống của XAMPP.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_localtour
DB_USERNAME=root
DB_PASSWORD=

# Thanh toán trực tuyến (Sprint 4). Để trống thì phương thức tương ứng hiện "đang tạm ngưng".
# VietQR: tài khoản nhận chuyển khoản (mã ngân hàng theo VietQR, vd. VCB, MB, TCB).
PAYMENT_BANK_ID=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=
# VNPay sandbox: đăng ký tại https://sandbox.vnpayment.vn/devreg/ để nhận mã website và khóa bí mật.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Để trống: tự tính theo địa chỉ đang mở, vd. http://localhost/LocalTour/src/public/payments/vnpay/return
VNPAY_RETURN_URL=

# Email "Đặt tour thành công" gửi cho khách khi đơn được xác nhận. Để trống MAIL_HOST thì không gửi email
# (đơn vẫn xác nhận bình thường, nhật ký email_logs ghi "skipped").
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls, MAIL_USERNAME = địa chỉ Gmail,
# MAIL_PASSWORD = mật khẩu ứng dụng 16 ký tự (bật Xác minh 2 bước, tạo ở https://myaccount.google.com/apppasswords),
# MAIL_FROM_ADDRESS = cùng địa chỉ Gmail. MAIL_ENCRYPTION: tls (STARTTLS, 587), ssl (465) hoặc none (chỉ thử trên máy).
# MAIL_FROM_NAME trống = "LocalTour".
MAIL_HOST=
MAIL_PORT=
MAIL_ENCRYPTION=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Đăng nhập bằng Google / Facebook (chỉ tài khoản khách hàng). Để trống thì nút tương ứng bị ẩn.
# Google: tạo OAuth client loại "Web application" tại https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Để trống: tự tính theo địa chỉ đang mở, vd. http://localhost/LocalTour_Project/src/public/auth/google/callback
# (phải khai báo đúng địa chỉ này ở Google; Google không nhận địa chỉ IP, trừ localhost / 127.0.0.1).
GOOGLE_REDIRECT_URI=
# Facebook: tạo app có sản phẩm "Facebook Login" tại https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Để trống: tự tính, vd. http://localhost/LocalTour_Project/src/public/auth/facebook/callback
FACEBOOK_REDIRECT_URI=
# reCAPTCHA v2 (ô "Tôi không phải người máy") ở /login, /register và /admin/login. Để trống thì không có captcha.
# Tạo khóa loại v2 Checkbox tại https://www.google.com/recaptcha/admin, tên miền localhost.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
